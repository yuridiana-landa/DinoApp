<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/back"
        android:scaleType="centerCrop">
    </ImageView>

    <ImageView
        android:layout_width="117dp"
        android:layout_height="121dp"
        android:layout_marginTop="70dp"
        android:scaleType="centerCrop"
        android:src="@drawable/dinom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </ImageView>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/top"
        android:scaleType="centerCrop">
    </ImageView>

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="25dp"
        app:cardElevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="650dp"
            android:background="@drawable/elementcolor"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="25dp"
                android:fontFamily="@font/kavoon"
                android:text="Inicia sesión"
                android:textColor="#5B844E"
                android:textSize="30sp" />

            <EditText
                android:id="@+id/etUsuario"
                android:layout_width="323dp"
                android:layout_height="60dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_insert"
                android:drawableStart="@drawable/person"
                android:drawablePadding="10dp"
                android:fontFamily="@font/kreon"
                android:hint="Email o usuario"
                android:inputType="text"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="@color/black"
                android:textColorHint="#BFD591"
                android:textSize="22dp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="323dp"
                android:layout_height="60dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_insert"
                android:drawableStart="@drawable/lock"
                android:drawablePadding="10dp"
                android:fontFamily="@font/kreon"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="@color/black"
                android:textColorHint="#BFD591"
                android:textSize="22dp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnIniciar"
                android:layout_width="227dp"
                android:layout_height="55dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_button"
                android:fontFamily="@font/kreon"
                android:text="Iniciar sesión"
                android:textColor="#ffffff"
                android:textSize="18dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCrearCuenta"
                android:layout_width="164dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="40dp"
                android:fontFamily="@font/kreon"
                android:text="¿No tienes cuenta? Crea una."
                android:textAlignment="center"
                android:textColor="#5B844E"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnGoogle"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:padding="0dp"
                android:scaleType="centerInside"
                android:background="@drawable/bg_buttongoogle"
                android:src="@drawable/google_logo" />

        </LinearLayout>

        <ImageView
            android:layout_width="494dp"
            android:layout_height="370dp"
            android:src="@drawable/bott"
            android:translationX="-28dp"
            android:translationY="400dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </ImageView>

        <ImageView
            android:layout_width="449dp"
            android:layout_height="367dp"
            android:src="@drawable/mmm"
            android:translationX="140dp"
            android:translationY="310dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </ImageView>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>